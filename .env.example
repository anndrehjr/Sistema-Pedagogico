# Todas as variáveis são OPCIONAIS na versão de demonstração.
# Copie este arquivo para .env.local para alterar algo. NUNCA coloque valores reais aqui.

# Segredo de assinatura das sessões (use um valor longo e aleatório em qualquer implantação real).
JWT_SECRET=troque-por-um-valor-longo-e-aleatorio

# Escola aberta por padrão (na demonstração já existe uma escola fictícia).
# NEXT_PUBLIC_ESCOLA_ID=00000000-0000-4000-8000-000000000001

# E-mails (Multi-Escolas) autorizados ao ajuste de notas em lote, separados por vírgula.
# Vazio = somente o Dev Master.
# AJUSTE_NOTAS_EMAILS=
